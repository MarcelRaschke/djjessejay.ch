{
  auto_https off
}

:8088 {
  encode zstd gzip

  @controlCenterApi path /api/control-center/*
  handle @controlCenterApi {
    reverse_proxy control-center-api:3100
  }

  @legacyApi path /api/*
  handle @legacyApi {
    reverse_proxy host.docker.internal:3000
  }

  handle {
    reverse_proxy host.docker.internal:3000
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }
}

# Production: replace :8088 with the intended control-center hostname,
# enable automatic HTTPS, and containerize the website frontend instead of
# using host.docker.internal for the legacy site process.
