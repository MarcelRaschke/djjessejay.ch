# Dependencies & build output
node_modules/
dist/

# Logs
*.log
npm-debug.log*

# Environment / secrets
.env
.env.local
.env*.local
.claude/settings.local.json

# Temporary & backup files
*.tmp
*.temp
*~
*.bak
*.backup
*.cache

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.vs/
*.swp
*.swo
*~
.idea/

# Archive/backup content
*wayback*
*archive.org*

# Database dumps & exports (historical data archives, not used by static site)
*.sql
*.xml

# Video files (large assets, not needed for GitHub Pages deployment)
*.mov
*.mp4
*.webm

# Legacy Flash files (non-functional, no longer supported)
*.swf

# Old HTML versions (legacy, not deployed)
home.html
home.htm

# Large binary files
*.zip
*.rar
*.7z

# IDE specific files
.idea/
.vs/

# Build artifacts
*.exe
*.dll
*.so

# Coverage reports
coverage/
.nyc_output/

# Test results
.test.cache

# Package lock files (optional, but can be regenerated)
# package-lock.json
# pnpm-lock.yaml
# yarn.lock
