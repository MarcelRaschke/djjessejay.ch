{
  "name": "djjessejay.ch",
  "version": "1.0.0",
  "description": "DJ Jesse Jay website — static site with Express.js backend and reCAPTCHA-protected contact form.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./tailwind.css --watch",
    "test": "node --check render-farm/render-farm-master.js && python3 -m py_compile render-farm/render-worker.py",
    "render:master": "node render-farm/render-farm-master.js"
  },
  "keywords": [
    "dj",
    "vanilla",
    "javascript",
    "tailwind",
    "express"
  ],
  "author": "Marcel Raschke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:39939/git/MarcelRaschke/djjessejay.ch"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "nodemailer": "^9.0.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "http-proxy-middleware": "^3.0.7",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "tailwindcss": "^4.2.2"
  }
}
