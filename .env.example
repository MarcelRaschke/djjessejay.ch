# reCAPTCHA v3 — get from https://www.google.com/recaptcha/admin
# Required server-side secret key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
# Optional if the frontend uses grecaptcha.execute()
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# Optional score threshold for reCAPTCHA v3 (default: 0.5)
RECAPTCHA_SCORE_THRESHOLD=0.5

# SMTP — required for email sending; omit to log-only
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password

# Where contact form submissions are delivered
CONTACT_EMAIL_TO=your@email.com

# Server port (default: 3000)
PORT=3000

# Serve the public site allowlist from the repository root (server.js).
# Leave unset in normal production: the public site is served by GitHub Pages via the wdjjj Worker.
# Set it for local preview (`npm run dev`) and, as the one production exception, for the
# documented custom-server rollback (docs/DEPLOYMENT.md -> Rollback Plan, step 1).
# SERVE_STATIC=1

# Read the client address from x-forwarded-for for rate limiting (src/client-key.js).
# Only set this when BOTH hold: the deployed wdjjj Worker overwrites x-forwarded-for from
# cf-connecting-ip, and the Access service-token policy keeps every other client off the
# origin (ORIGIN-PROTECTION-DEPLOYMENT.md). Set too early, a client can rotate spoofed
# addresses through fresh rate-limit buckets. Unset, both limiters key on the socket
# address: one shared bucket, which throttles too broadly but cannot be escaped.
# TRUST_FORWARDED_FOR=1
