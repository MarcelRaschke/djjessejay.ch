# Cloudflare Turnstile — Cloudflare Dashboard > Turnstile > Widget für djjessejay.ch
# Required server-side secret key (nur auf dem Origin, nie im Repo)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Optional: akzeptierte Hostnamen, kommasepariert (Default: djjessejay.ch,www.djjessejay.ch)
TURNSTILE_HOSTNAMES=djjessejay.ch,www.djjessejay.ch
# Site key ist öffentlich und wird als GitHub-Repository-Variable TURNSTILE_SITE_KEY gesetzt

# SMTP — required for email sending; omit to log-only
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password

# Where contact form submissions are delivered
CONTACT_EMAIL_TO=your@email.com

# Server port (default: 3000)
PORT=3000
