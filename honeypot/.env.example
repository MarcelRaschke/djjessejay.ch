# Honeypot Configuration Example
# Copy this to .env and customize for your environment

# Enable honeypot alerts (email + webhook)
HONEYPOT_ALERTS=true

# Secret token for monitoring dashboard access
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HONEYPOT_MONITOR_TOKEN=your_secret_token_here_change_this

# Email recipient for honeypot alerts
# Only used if HONEYPOT_ALERTS=true and SMTP is configured
HONEYPOT_ALERT_EMAIL=security@djjessejay.ch

# Optional: Webhook URL for alerts (e.g., Slack, Discord, custom service)
# Receives POST requests with alert data
HONEYPOT_WEBHOOK_URL=https://your-webhook-service.com/alerts

# SMTP Configuration (required for email alerts)
# These are used by honeypot alerts AND contact form notifications
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@djjessejay.ch
SMTP_PASS=your_smtp_password_here
SMTP_SECURE=false
SMTP_REJECT_UNAUTHORIZED=true

# Example: Using Gmail SMTP (less secure, not recommended for production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password-here
# SMTP_SECURE=false

# Example: Using Mailgun API (via SMTP gateway)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@sandboxXXX.mailgun.org
# SMTP_PASS=your-mailgun-api-key

# Example: Using SendGrid SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key
