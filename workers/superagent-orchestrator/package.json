{
  "name": "@djjessejay/superagent-orchestrator-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "tail": "wrangler tail",
    "queue:create": "wrangler queues create superagent-merge-jobs && wrangler queues create superagent-merge-jobs-dlq"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.24.3"
  },
  "engines": {
    "node": ">=22"
  }
}
