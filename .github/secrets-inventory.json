{
  "$comment": "Single source of truth for every GitHub Actions secret in this repository. Checked by scripts/secrets-audit.py (static: on every PR; remote: weekly via SECRETS_AUDIT_TOKEN). Values never live here, only metadata.",
  "version": 1,
  "builtin": [
    "GITHUB_TOKEN"
  ],
  "secrets": [
    {
      "name": "CLOUDFLARE_API_TOKEN",
      "scope": [
        "repository",
        "environment:cloudflare-preview"
      ],
      "status": "active",
      "required": false,
      "format": "token",
      "rotation_days": 90,
      "consumers": [
        ".github/workflows/cloudflare-pgp-worker.yml",
        ".github/workflows/cloudflare-superagent-orchestrator.yml",
        ".github/workflows/deploy-wdjjj.yml"
      ],
      "owner": "cy8er",
      "purpose": "Workers deploy token. Scope to Workers Scripts Edit on this account only; separate from the cache purge token."
    },
    {
      "name": "CLOUDFLARE_ACCOUNT_ID",
      "scope": [
        "repository",
        "environment:cloudflare-preview"
      ],
      "status": "active",
      "required": false,
      "format": "id",
      "rotation_days": null,
      "consumers": [
        ".github/workflows/cloudflare-pgp-worker.yml",
        ".github/workflows/cloudflare-superagent-orchestrator.yml",
        ".github/workflows/deploy-wdjjj.yml"
      ],
      "owner": "cy8er",
      "purpose": "Cloudflare account ID. Not secret; candidate for a repo variable."
    },
    {
      "name": "CF_CACHE_PURGE_TOKEN",
      "scope": "environment:github-pages",
      "status": "active",
      "required": false,
      "format": "token",
      "rotation_days": 90,
      "consumers": [
        ".github/workflows/static.yml"
      ],
      "owner": "cy8er",
      "purpose": "Cloudflare token, zone djjessejay.ch only: Zone.Cache Purge + Zone.Zone Read. Zone ID in vars.CLOUDFLARE_ZONE_ID."
    },
    {
      "name": "GCP_SA_KEY",
      "scope": "repository",
      "status": "active",
      "required": false,
      "format": "gcp-service-account-json",
      "rotation_days": 90,
      "consumers": [
        ".github/workflows/quickshare_deploy.yml"
      ],
      "owner": "cy8er",
      "purpose": "Long-lived service account key. Replace with Workload Identity Federation, then mark forbidden."
    },
    {
      "name": "GCP_cy8er",
      "scope": "repository",
      "status": "active",
      "required": false,
      "format": "gcp-project-id",
      "rotation_days": null,
      "consumers": [
        ".github/workflows/quickshare_deploy.yml"
      ],
      "owner": "cy8er",
      "purpose": "GCP project ID. Not secret; candidate for a repo variable."
    },
    {
      "name": "GH_PR_TOKEN",
      "scope": "repository",
      "status": "active",
      "required": false,
      "format": "github-fine-grained-pat",
      "rotation_days": 90,
      "consumers": [
        ".github/workflows/auto-pr.yml"
      ],
      "owner": "cy8er",
      "purpose": "PAT for auto-pr.yml. Fine-grained, this repo only, Contents RW + Pull requests RW."
    },
    {
      "name": "IVDJ_TRIAGE_TOKEN",
      "scope": "repository",
      "status": "active",
      "required": false,
      "format": "github-fine-grained-pat",
      "rotation_days": 90,
      "consumers": [
        ".github/workflows/triage-bootstrap.yml",
        ".github/workflows/triage-loop.yml"
      ],
      "owner": "cy8er",
      "purpose": "PAT for the triage workflows. Fine-grained, only the repos triage touches."
    },
    {
      "name": "SLACK_WEBHOOK_CRITICAL",
      "scope": "repository",
      "status": "active",
      "required": false,
      "format": "url",
      "rotation_days": 180,
      "consumers": [
        ".github/workflows/triage-loop.yml"
      ],
      "owner": "cy8er",
      "purpose": "Slack incoming webhook, critical channel."
    },
    {
      "name": "SLACK_WEBHOOK_GITHUB",
      "scope": "repository",
      "status": "active",
      "required": false,
      "format": "url",
      "rotation_days": 180,
      "consumers": [
        ".github/workflows/triage-loop.yml"
      ],
      "owner": "cy8er",
      "purpose": "Slack incoming webhook, GitHub channel."
    },
    {
      "name": "AUDIO_HOST_ATTESTATION_B64",
      "scope": "repository",
      "status": "active",
      "required": false,
      "format": "base64",
      "rotation_days": null,
      "consumers": [
        ".github/workflows/audio-host-security.yml"
      ],
      "owner": "cy8er",
      "purpose": "Audio host attestation blob. Renew with each attestation."
    },
    {
      "name": "AUDIO_HOST_ROOT_PUB_B64",
      "scope": "repository",
      "status": "active",
      "required": false,
      "format": "public-key-base64",
      "rotation_days": null,
      "consumers": [
        ".github/workflows/audio-host-security.yml"
      ],
      "owner": "cy8er",
      "purpose": "Root public key. Public material; candidate for a repo variable."
    },
    {
      "name": "SECRETS_AUDIT_TOKEN",
      "scope": "repository",
      "status": "active",
      "required": false,
      "format": "github-fine-grained-pat",
      "rotation_days": 90,
      "consumers": [
        ".github/workflows/secret-management.yml"
      ],
      "owner": "cy8er",
      "purpose": "Fine-grained PAT, repos djjessejay.ch + Blue-Dimension-. Secrets R, Environments R, Metadata R. Lists names and updated_at only."
    },
    {
      "name": "WEB3_PRIVATE_KEY",
      "scope": "repository",
      "status": "forbidden",
      "required": false,
      "format": "none",
      "rotation_days": null,
      "consumers": [],
      "owner": "cy8er",
      "purpose": "Wallet keys never go into CI."
    }
  ]
}
